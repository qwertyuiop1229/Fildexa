{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source":"**","headers":[
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"no-referrer"}
      ]},
      {"source":"/vendor/esbuild.wasm","headers":[{"key":"Content-Type","value":"application/wasm"}]}
    ]
  }
}
